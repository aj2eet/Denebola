<#assign metaDescription = "Explore Denebola's four solution areas: live class management, fee & school management, feedback & assessment, and data science & AI for education." />
<#assign canonicalPath = "/solutions.html" />
<#assign navActive = "solutions" />
<!DOCTYPE html>
<html lang="en">
<#include "partials/head.ftl">
<body class="page-solutions">
<#include "partials/nav.ftl">

  <main id="main">
    <section class="page-header">
      <div class="wrap">
        <p class="eyebrow">Solutions</p>
        <h1>Four connected solution areas</h1>
        <p class="page-header__lead">Use one, or use all four — every part of Denebola is built to work together.</p>
      </div>
    </section>

    <section id="live-classes" class="solution-block">
      <div class="wrap solution-block__inner">
        <div class="solution-block__text">
          <span class="card__icon" aria-hidden="true">&#9679;</span>
          <h2>Live Class Management</h2>
          <p>Run live sessions without stitching together a video tool, a calendar, and a spreadsheet of who showed up.</p>
          <ul class="feature-list">
            <li>Scheduling and calendar sync for classes, sections, and faculty</li>
            <li>Automatic attendance capture and session recordings</li>
            <li>Breakout sessions, polls, and Q&amp;A built into the class flow</li>
            <li>Recording library students can revisit after class</li>
          </ul>
        </div>
      </div>
    </section>

    <section id="fee-school" class="solution-block solution-block--alt">
      <div class="wrap solution-block__inner">
        <div class="solution-block__text">
          <span class="card__icon" aria-hidden="true">&#9670;</span>
          <h2>Fee &amp; School Management</h2>
          <p>Admissions, timetables, and fee collection handled in one place, with a clear record for every family and finance team.</p>
          <ul class="feature-list">
            <li>Online fee collection with reminders and receipts</li>
            <li>Admissions and enrollment tracking</li>
            <li>Timetable and section management</li>
            <li>Role-based access for staff, faculty, and administration</li>
          </ul>
        </div>
      </div>
    </section>

    <section id="feedback" class="solution-block">
      <div class="wrap solution-block__inner">
        <div class="solution-block__text">
          <span class="card__icon" aria-hidden="true">&#9733;</span>
          <h2>Feedback &amp; Assessment</h2>
          <p>Feedback that goes somewhere — structured surveys and assessments for students, parents, and faculty, with results routed to the people who can act on them.</p>
          <ul class="feature-list">
            <li>Configurable feedback forms and assessment templates</li>
            <li>Automated collection after classes, terms, or milestones</li>
            <li>Trend tracking across cohorts and time</li>
            <li>Exportable reports for accreditation and reviews</li>
          </ul>
        </div>
      </div>
    </section>

    <section id="data-ai" class="solution-block solution-block--alt">
      <div class="wrap solution-block__inner">
        <div class="solution-block__text">
          <span class="card__icon" aria-hidden="true">&#10022;</span>
          <h2>Data Science &amp; AI for Education</h2>
          <p>Attendance, fee, and performance data only helps if someone can act on it in time. Our models flag what needs attention.</p>
          <ul class="feature-list">
            <li>Early-warning signals for at-risk students</li>
            <li>Fee-delinquency and enrollment-trend forecasting</li>
            <li>Engagement analytics across classes and cohorts</li>
            <li>Custom dashboards for leadership and faculty</li>
          </ul>
        </div>
      </div>
    </section>

    <section class="section cta-banner">
      <div class="wrap cta-banner__inner">
        <div>
          <h2>Not sure which solutions fit your institution?</h2>
          <p>Tell us what you're working with today — we'll show you where Denebola fits.</p>
        </div>
        <a href="/contact.html" class="btn btn--primary btn--large">Request a demo</a>
      </div>
    </section>
  </main>

<#include "partials/footer.ftl">
<#include "partials/scripts.ftl">
</body>
</html>
