<#assign metaDescription = "Denebola gives schools and universities one platform for live classes, fee and school management, feedback, and data-driven insight." />
<#assign canonicalPath = "/" />
<#assign navActive = "home" />
<!DOCTYPE html>
<html lang="en">
<#include "partials/head.ftl">
<body class="page-home">
<#include "partials/nav.ftl">

  <main id="main">
    <section class="hero">
      <div class="wrap hero__inner">
        <p class="eyebrow">Online learning infrastructure</p>
        <h1 class="hero__title">One platform to run every part of your institution's learning, online.</h1>
        <p class="hero__lead">
          Denebola brings live classes, fee and school administration, feedback, and
          data science &amp; AI together in a single system built for schools and
          universities — so your staff spend less time juggling tools and more
          time teaching.
        </p>
        <div class="hero__actions">
          <a href="/contact.html" class="btn btn--primary btn--large">Request a demo</a>
          <a href="/solutions.html" class="btn btn--ghost btn--large">Explore solutions</a>
        </div>
      </div>
      <div class="hero__stars" aria-hidden="true"></div>
    </section>

    <section class="section">
      <div class="wrap">
        <h2 class="section__title">Everything an institution needs, under one roof</h2>
        <p class="section__lead">Four connected solution areas, built to work together instead of around each other.</p>

        <div class="card-grid">
          <a class="card" href="/solutions.html#live-classes">
            <span class="card__icon" aria-hidden="true">&#9679;</span>
            <h3>Live Class Management</h3>
            <p>Schedule, host, and record live sessions with attendance, engagement, and recordings handled automatically.</p>
          </a>
          <a class="card" href="/solutions.html#fee-school">
            <span class="card__icon" aria-hidden="true">&#9670;</span>
            <h3>Fee &amp; School Management</h3>
            <p>Admissions, fee collection, timetables, and day-to-day school administration in one connected system.</p>
          </a>
          <a class="card" href="/solutions.html#feedback">
            <span class="card__icon" aria-hidden="true">&#9733;</span>
            <h3>Feedback &amp; Assessment</h3>
            <p>Structured feedback loops for students, parents, and faculty — captured, tracked, and actually acted on.</p>
          </a>
          <a class="card" href="/solutions.html#data-ai">
            <span class="card__icon" aria-hidden="true">&#10022;</span>
            <h3>Data Science &amp; AI</h3>
            <p>Turn attendance, performance, and engagement data into early warnings and decisions leadership can trust.</p>
          </a>
        </div>
      </div>
    </section>

    <section class="section section--muted">
      <div class="wrap benefits">
        <div class="benefits__item">
          <h3>Built for education, not adapted to it</h3>
          <p>Every workflow — from a fee reminder to a live class recording — is designed around how schools and universities actually operate.</p>
        </div>
        <div class="benefits__item">
          <h3>One system, fewer logins</h3>
          <p>Replace a patchwork of spreadsheets, payment links, and video tools with a single connected platform.</p>
        </div>
        <div class="benefits__item">
          <h3>Insight, not just data</h3>
          <p>Our data science and AI layer surfaces what matters — at-risk students, fee delays, engagement dips — before they become problems.</p>
        </div>
      </div>
    </section>

    <section class="section cta-banner">
      <div class="wrap cta-banner__inner">
        <div>
          <h2>See Denebola on your own institution's data</h2>
          <p>Book a short walkthrough — no commitment, just a look at what it could do for you.</p>
        </div>
        <a href="/contact.html" class="btn btn--primary btn--large">Request a demo</a>
      </div>
    </section>
  </main>

<#include "partials/footer.ftl">
<#include "partials/scripts.ftl">
</body>
</html>
